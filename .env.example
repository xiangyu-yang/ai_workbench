# ── 运行环境 ──────────────────────────────────────────────
NODE_ENV=development
PORT=3100
APP_URL=http://localhost:3100

# 会话/密钥加密根密钥（生产必填，>=32 字符；轮换将使已存凭据失效）
# 留空时自动生成并持久化到 DATA_DIR/.app-secret（仅适合单机）
# APP_SECRET=please-generate-with-openssl-rand-hex-32

# ── 数据存储 ──────────────────────────────────────────────
# 留空 → 使用内置 PGlite（零依赖，单机）；生产请填写 Postgres 连接串
# DATABASE_URL=postgres://cuter:cuter@localhost:5432/cuter
DATA_DIR=./.data
MIGRATE_ON_BOOT=true

# ── 本地 Ollama（原生协议）────────────────────────────────
# 单次请求分配的上下文窗口；过小会导致思考过程挤占最终回答
OLLAMA_NUM_CTX=24576
# 是否输出思考过程。本地模型建议 false，优先保证最终回答稳定
OLLAMA_THINK=false
# 模型驻留时间，避免频繁重载 35B 级模型
OLLAMA_KEEP_ALIVE=30m
# 本地模型连续无输出多久后中断（毫秒），避免界面无限卡住
OLLAMA_IDLE_TIMEOUT_MS=180000

# ── 任务执行 ──────────────────────────────────────────────
# 进程内执行器（单机默认）。生产可设为 false 并单独启动 npm run worker
INPROCESS_WORKER=true
TASK_CONCURRENCY=2

# ── 能力开关 ──────────────────────────────────────────────
# 允许管理员登记 stdio 类型 MCP（会派生本地进程，托管环境请关闭）
MCP_ALLOW_STDIO=true
# 允许技能 scripts/ 执行（需人工审批；生产建议 false，除非有沙箱）
SKILL_ALLOW_SCRIPTS=true
# 联网搜索（Tavily），留空则 web_search 工具提示未配置
TAVILY_API_KEY=
# 允许工具访问的额外域名（逗号分隔，默认阻止私网）
TOOL_ALLOWED_HOSTS=
# 演示模式：无模型密钥时使用内置演示模型
DEMO_MODE=true
